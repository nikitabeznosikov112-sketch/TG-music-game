# Токены и ключи API (замени на свои)
BOT_TOKEN=your_telegram_bot_token_here
API_KEY_LAST_FM=your_lastfm_api_key_here
AUTHORIZATION_KEY_TMDB=your_tmdb_bearer_token_here

# Данные для входа в админку
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Настройки базы данных для Docker (используются в compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=botdb

# Строка подключения для локального запуска (без Docker)
DATABASE_URL=postgresql+psycopg2://postgres:your_db_password_here@localhost:5432/botdb